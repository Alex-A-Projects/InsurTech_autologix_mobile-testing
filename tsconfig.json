{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./.tsc-out",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@pages/*": ["tests/pageobjects/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@helpers/*": ["tests/helpers/*"],
      "@utils/*": ["tests/utils/*"]
    },
    "types": [
      "node",
      "@wdio/types",
      "@wdio/mocha-framework",
      "expect-webdriverio",
      "@wdio/globals"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".tsc-out",
    "allure-results",
    "allure-report"
  ]
}
