{
  "name": "autologix-mobile-testing",
  "version": "1.0.0",
  "description": "Mobile-web automation framework for the AutoLogix InsurTech SPA — WebdriverIO + Appium 2/3 running Safari on iOS Simulator and Chrome on Android Emulator.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:both": "wdio run wdio.ios.conf.ts && wdio run wdio.android.conf.ts",
    "test:ios:single": "wdio run wdio.ios.conf.ts --spec",
    "test:android:single": "wdio run wdio.android.conf.ts --spec",
    "test:smoke:ios": "wdio run wdio.ios.conf.ts --mochaOpts.grep=@smoke",
    "test:smoke:android": "wdio run wdio.android.conf.ts --mochaOpts.grep=@smoke",
    "test:regression:ios": "wdio run wdio.ios.conf.ts --mochaOpts.grep=@regression",
    "test:regression:android": "wdio run wdio.android.conf.ts --mochaOpts.grep=@regression",
    "appium:doctor:ios": "appium-doctor --android || true",
    "appium:install-drivers": "appium driver install uiautomator2 && appium driver install xcuitest",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"tests/**/*.{ts,json,md}\" \"config/**/*.ts\""
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mobile-web",
    "ios-simulator",
    "android-emulator",
    "safari",
    "chrome",
    "xcuitest",
    "uiautomator2",
    "autologix",
    "insurtech",
    "page-object-model",
    "allure",
    "mobile-automation",
    "typescript"
  ],
  "author": "QA Automation Portfolio",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "allure-commandline": "^2.27.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^2.45.1",
    "appium-xcuitest-driver": "^8.4.3",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^4.15.4",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "webdriverio": "^9.32.0"
  }
}
