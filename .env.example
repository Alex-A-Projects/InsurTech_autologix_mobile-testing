# ============================================================================
# AutoLogix Mobile-Web Automation — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values.
#
# This framework runs WebdriverIO + Appium 2/3 against a deployed SPA. The
# iOS Simulator and Android Emulator themselves are NOT part of the npm
# install — they must already be present on the host (Xcode + iPhone 17
# simulator, Android Studio + Samsung Galaxy AVD). The framework simply
# points Appium at them.
# ============================================================================

# -------- App under test ---------------------------------------------------
APP_BASE_URL=https://autologix.vercel.app
API_BASE_URL=https://autologix-wxkf.onrender.com

# -------- Test accounts (published by the app owner) -----------------------
USER_EMAIL=test@test.test
USER_PASSWORD=zaq1@WSX

INSURER_EMAIL=insurer@autologix.dev
INSURER_PASSWORD="Dev123!@#"

SERVICE_EMAIL=service@autologix.dev
SERVICE_PASSWORD="Dev123!@#"

# -------- Browser / locale -------------------------------------------------
# Browser UI locale. The page reports Polish (pl-PL); we set en-US so that
# native browser translation may render English where supported.
BROWSER_LOCALE=en-US
PAGE_LOCALE=pl-PL

# -------- Test execution ---------------------------------------------------
LOG_LEVEL=info
MOCHA_TIMEOUT=60000       # 60 s — generous for animated SPAs and first-load fetches
EXPECT_TIMEOUT=10000
RETRIES=1
SPEC_TIMEOUT=120000

# -------- Allure reporting -------------------------------------------------
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# ============================================================================
# iOS Simulator (Apple's iPhone 17-series)
# ============================================================================
# Override the device name to point at any installed iPhone 17 simulator.
IOS_DEVICE_NAME=iPhone 17
IOS_PLATFORM_VERSION=18.2
IOS_BUNDLE_ID=com.apple.mobilesafari
IOS_NEW_COMMAND_TIMEOUT=180
IOS_WDA_PORT=8100

# ============================================================================
# Android Emulator (Samsung Galaxy device profile)
# ============================================================================
ANDROID_DEVICE_NAME=Samsung Galaxy S25
ANDROID_PLATFORM_VERSION=14.0
ANDROID_BROWSER_NAME=Chrome
ANDROID_CHROMEDRIVER_AUTODOWNLOAD=true
ANDROID_AVD_READY_TIMEOUT=180000
ANDROID_NEW_COMMAND_TIMEOUT=180

# ============================================================================
# Appium server
# ============================================================================
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_LOG_LEVEL=info
